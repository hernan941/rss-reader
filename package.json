{
  "name": "rss-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/assets-version.mjs",
    "dev": "wrangler dev",
    "predeploy": "node scripts/assets-version.mjs",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "pretypecheck": "node scripts/assets-version.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/assets-version.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
